{
  "appId": "com.biomixer.app",
  "appName": "Mixync",
  "webDir": "dist",
  "server": {
    "cleartext": true,
    "hostname": "localhost",
    "androidScheme": "http",
    "allowNavigation": [
      "10.0.2.2",
      "localhost"
    ]
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    }
  },
  "overrideUserAgent": "Mozilla/5.0 (Linux; Android 10; K) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/119.0.0.0 Mobile Safari/537.36"
}